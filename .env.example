# Maya Payment Links. Sandbox by default. Production hosts are mymaya.me / paymaya.me.
# A blank base URL means SANDBOX. Setting MAYA_MERCHANT_ALIAS with a blank base URL is an error:
# set this explicitly whenever an alias is configured.
MAYA_PAYMENT_LINK_BASE_URL=https://sandbox.mymaya.me
# The ONE merchant alias. Blank on a sandbox host falls back to Maya's shared sandbox alias (SbxInv).
# A live host never falls back and rejects SbxInv: it must be set to the real alias.
MAYA_MERCHANT_ALIAS=

# The secret checkout link: https://<site>/checkout/<CHECKOUT_LINK_TOKEN>
# At least 24 URL-safe characters (A-Z a-z 0-9 - _), for example:
#   openssl rand -base64 24 | tr '+/' '-_' | tr -d =
# UNSET (or too short, or not URL-safe) means checkout is CLOSED: 404 on the page and the API.
# Changing it retires every old link. Server only. Never commit a real value.
CHECKOUT_LINK_TOKEN=
# Checkout requests per IP per minute.
CHECKOUT_RATE_LIMIT_PER_MIN=20
# Inquiry submissions per IP per minute. Blank means the default of 5.
INQUIRY_RATE_LIMIT_PER_MIN=

# Supabase (orders and inquiries). On a LIVE Maya host checkout refuses (503) unless all three are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://judiesaudio.example
# Contact details are shown only when set; hidden when blank. Phone in international format, e.g. +639171234567.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
